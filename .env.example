# ================================================================
# AI Trading Bot — environment file (copy to .env and fill in)
# ================================================================
# The upstream Capital.com MCP server uses CAP_* names. The build spec
# used CAPITAL_* names — those are wrong. Do NOT rename. See
# docs/UPSTREAM_MCP_FINDINGS.md.

# ---------------- Capital.com MCP (upstream) ----------------------
CAP_ENV=demo                            # demo | live
CAP_API_KEY=                            # Capital.com Settings > API integrations
CAP_IDENTIFIER=                         # Login email
CAP_API_PASSWORD=                       # API custom password (NOT platform password)
CAP_DEFAULT_ACCOUNT_ID=                 # Optional

# ---------------- Upstream MCP safety controls --------------------
CAP_ALLOW_TRADING=false                 # Master trading switch
CAP_ALLOWED_EPICS=                      # CSV; empty = block all; 'ALL' = unrestricted (never use in live)
CAP_MAX_POSITION_SIZE=1.0
CAP_MAX_WORKING_ORDER_SIZE=1.0
CAP_MAX_OPEN_POSITIONS=3
CAP_MAX_ORDERS_PER_DAY=20
CAP_REQUIRE_EXPLICIT_CONFIRM=true
CAP_DRY_RUN=false
CAP_HTTP_TIMEOUT_S=15
CAP_LOG_LEVEL=INFO
CAP_WS_ENABLED=false

# ---------------- Our agent driver --------------------------------
ANTHROPIC_API_KEY=                      # Claude Code CLI credential

# Master live-trading guard. Even with CAP_ENV=live, our driver refuses to
# run unless this is exactly YES.
I_UNDERSTAND_LIVE_RISK=NO

# ---------------- Alerts ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Health API --------------------------------------
HEALTH_API_TOKEN=                       # Required for /kill and /unlock endpoints
HEALTH_API_BIND=127.0.0.1:8080

# ---------------- State & logs ------------------------------------
CAPITAL_AGENT_STATE_DIR=/var/lib/capital-agent
CAPITAL_AGENT_LOG_DIR=/var/log/capital-agent
